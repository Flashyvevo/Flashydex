# FlashyDex recognition service: all optional. See services/recognition/README.md.
FLASHYDEX_RECOG_HOST=127.0.0.1
FLASHYDEX_RECOG_PORT=8900
# Shared bearer token. REQUIRED when exposed through Cloudflare Tunnel (the tunnel connects from 127.0.0.1).
FLASHYDEX_RECOG_TOKEN=
FLASHYDEX_RECOG_ALLOWED_ORIGINS=https://localhost:3200,https://127.0.0.1:3200,https://10.0.0.4:3200
# FLASHYDEX_RECOG_DATA_DIR=services/recognition/data
# FLASHYDEX_RECOG_CATALOG_DIR=.agent/metrics/packs
# FLASHYDEX_RECOG_ORT_THREADS=0
# FLASHYDEX_RECOG_LOG_LEVEL=INFO

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "FlashyDex"
    },
    "backupVersion": {
      "type": "number",
      "const": 1
    },
    "entitiesVersion": {
      "type": "number",
      "const": 1
    },
    "settingsVersion": {
      "type": "number",
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "appVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "backupId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "entries": {
      "minItems": 2,
      "maxItems": 10010,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "compression": {
            "type": "string",
            "enum": [
              "deflate",
              "store"
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "compression"
        ],
        "additionalProperties": false
      }
    },
    "counts": {
      "type": "object",
      "properties": {
        "ownedCards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "customCards": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "acquisitions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "grades": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "storageLocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collectionGroups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "collectionGroupMembers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scanSessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "priceSnapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "catalogIdentities": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "catalogAnnotations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "userImages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ownedCards",
        "customCards",
        "acquisitions",
        "grades",
        "storageLocations",
        "collectionGroups",
        "collectionGroupMembers",
        "scanSessions",
        "priceSnapshots",
        "catalogIdentities",
        "catalogAnnotations",
        "userImages"
      ],
      "additionalProperties": false
    },
    "includesUserImages": {
      "type": "boolean"
    },
    "includesCatalogs": {
      "type": "boolean"
    },
    "catalogs": {
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "enum": [
              "en",
              "ja"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "schemaVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "baselineSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entryPath": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "rawSha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "uncompressedBytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "language",
          "version",
          "schemaVersion",
          "baselineSha256",
          "entryPath",
          "rawSha256",
          "uncompressedBytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "backupVersion",
    "entitiesVersion",
    "settingsVersion",
    "createdAt",
    "appVersion",
    "backupId",
    "entries",
    "counts",
    "includesUserImages",
    "includesCatalogs",
    "catalogs"
  ],
  "additionalProperties": false,
  "$id": "https://flashydex.local/schemas/fdx-manifest.v1.schema.json",
  "title": "FlashyDex .fdx backup manifest v1",
  "description": "Backup manifest; entry hashes are verified over decompressed bytes."
}

{
  "name": "pokescan",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pokescan/web",
    "build": "npm run build --workspace=@pokescan/web",
    "test": "npm run test --workspace=@pokescan/web && bash scripts/test-recognition.sh",
    "e2e": "npm run e2e --workspace=@pokescan/web",
    "typecheck": "npm run typecheck --workspace=@pokescan/web && npm run typecheck --workspace=@pokescan/schemas",
    "lint": "npm run lint --workspace=@pokescan/web",
    "db:generate": "npm run db:generate --workspace=@pokescan/web",
    "db:migrate": "npm run db:migrate --workspace=@pokescan/web",
    "sync": "bash scripts/sync-placeholder.sh"
  }
}
